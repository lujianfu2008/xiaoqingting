# 服务端配置（复制为 .env 并按需修改；密钥只存在于服务端）

# 监听端口（生产环境建议用 Nginx 反代到 443）
PORT=8788
HOST=0.0.0.0

# 登录账号（客户端登录用）
BLMA_USERNAME=admin
BLMA_PASSWORD=change-me
# 管理员工号（仅用于界面展示；不设置则与用户名相同）
BLMA_EMPLOYEE_ID=admin

# JWT 签名密钥（务必修改为随机长字符串）
JWT_SECRET=please-change-this-to-a-random-secret

# 加密每个用户自填的大模型 Key（不设置则回退到 JWT_SECRET）
CREDENTIAL_SECRET=please-change-this-to-another-random-secret

# 数据目录（会话元数据、历史、工作区）
DATA_DIR=./data

# 引擎 API Key（服务端持有，不下发给客户端）
ANTHROPIC_API_KEY=sk-ant-...
# 如需中转/代理：
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# 限额
MAX_TURNS=50
MAX_BUDGET_USD=5

# 工具审批等待超时（毫秒，超时自动拒绝）
PERMISSION_TIMEOUT_MS=300000

# 会话空闲回收（毫秒）
SESSION_IDLE_MS=600000

# 是否向客户端下发用量/成本信息
REVEAL_USAGE=false
